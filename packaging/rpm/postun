#!/bin/sh
# Drop the unit cache entry that pointed at the removed files. This is the rpm
# counterpart of packaging/deb/postrm and runs as the package's %postun. The panel's
# own state under /etc/sing-box is left alone, the way `dnf remove` keeps a removed
# program's configuration.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
