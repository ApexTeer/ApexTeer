#!/bin/sh
# Refresh systemd's unit cache now that the packaged units are on disk. This is the
# rpm counterpart of packaging/deb/postinst and runs as the package's %post.
#
# The service is deliberately not enabled or started here: a fresh install has no
# node configuration yet, so `easysb core run` would fail and restart forever. The
# panel enables and starts the service once the user has configured the node.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
