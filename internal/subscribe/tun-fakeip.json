{
  // 架构定义文件，用于编辑器的 JSON 校验与智能提示
  "$schema": "https://sing-box.sagernet.org/schema.json",

  // 日志记录配置
  "log": {
    "level": "info",                     // 日志输出级别（可选: trace, debug, info, warn, error, fatal）
    "timestamp": true                   // 日志输出中是否包含高精度时间戳
  },

  // 系统内部 HTTP 客户端配置（用于下载远程规则集等内部网络请求）
  "http_clients": [
    {
      "tag": "rule-set-direct"         // HTTP 客户端的唯一标识标签
    }
  ],

  // DNS 模块全局配置
  "dns": {
    // DNS 服务器列表配置
    "servers": [
      // 1. FakeIP（伪造 IP）服务器配置：用于 TUN 模式快速建立本地连接
      {
        "type": "fakeip",               // 服务器类型：FakeIP 引擎
        "tag": "fakeip",                 // 标识标签
        "inet4_range": "198.18.0.0/15",  // 预分配给 IPv4 域名的伪造 IP 地址池范围
        "inet6_range": "fc00::/18"       // 预分配给 IPv6 域名的伪造 IP 地址池范围
      },
      // 2. 国内直连 DNS 服务器（阿里 DNS，UDP 53 端口）
      {
        "type": "udp",                  // 服务器类型：标准 UDP DNS
        "tag": "dns-cn",                // 标识标签：国内 DNS
        "server": "223.5.5.5",          // DNS 服务器 IP 地址
        "server_port": 53               // DNS 服务器监听端口
      },
      // 3. 远端加密 DNS 服务器（Google DoH，通过代理网络请求）
      {
        "type": "https",                // 服务器类型：DNS over HTTPS (DoH)
        "tag": "dns-proxy",             // 标识标签：代理 DNS
        "server": "dns.google",         // DoH 域名服务器地址
        "domain_resolver": "dns-cn",    // 解析 dns.google 域名本身所使用的 DNS 服务器（避免死循环）
        "detour": "proxy"               // 请求出站走代理线路组
      }
    ],

    // DNS 匹配与分流规则
    "rules": [
      // 国内常见域名（geosite-cn）：强行路由给国内 DNS 解析
      {
        "rule_set": ["geosite-cn"],     // 匹配条件：国内域名规则集
        "action": "route",              // 执行动作：指定路由目标
        "server": "dns-cn"              // 使用的 DNS 服务器标签
      },
      // 常规域名 IPv4/IPv6 (A/AAAA) 查询：直接返回 FakeIP 地址
      {
        "query_type": ["A", "AAAA"],    // 匹配条件：查询记录类型为 A 或 AAAA
        "action": "route",              // 执行动作：指定路由目标
        "server": "fakeip"              // 使用 FakeIP 服务器返回虚拟 IP
      }
    ],

    "final": "dns-proxy",                // 未匹配任何 DNS 规则时的默认/兜底 DNS 服务器
    "strategy": "prefer_ipv4",           // 双栈解析策略：优先返回 IPv4 地址（可选: prefer_ipv4, prefer_ipv6, ipv4_only, ipv6_only）
    "cache_capacity": 8192,              // DNS 本地缓存的最大条目数量
    "optimistic": {                      // 乐观缓存配置（在缓存过期时先返回旧结果并后台异步更新）
      "enabled": true,                   // 开启乐观缓存
      "timeout": "1h"                    // 过期缓存可被继续使用的最大时长
    },
    "timeout": "10s",                    // 单次 DNS 查询的超时时间
    "reverse_mapping": true              // 开启 IP 反向映射（将 FakeIP 还原为原始域名，方便路由匹配与日志显示）
  },

  // 入站协议配置（定义软件如何接收设备本地流量）
  "inbounds": [
    {
      "type": "tun",                     // 入站类型：TUN 虚拟网卡（接管系统全局网络流量）
      "tag": "tun-in",                   // 入站标识标签
      "address": [                       // TUN 虚拟网卡分配的内网地址
        "172.19.0.1/30",                 // IPv4 虚拟网关及子网掩码
        "fdfe:dcba:9876::1/126"          // IPv6 虚拟网关及子网掩码
      ],
      "auto_route": true,                // 是否自动修改系统路由表以接管所有网络流量
      "strict_route": true,              // 是否启用严格路由规则（防止 DNS / IPv6 泄漏或回环）
      "mtu": 1420                        // 虚拟网卡的最大传输单元（MTU）
    },
    {
      "type": "mixed",                   // 入站类型：混合代理（HTTP + SOCKS5 同一端口）
      "tag": "mixed-in",                 // 入站标识标签
      "listen": "127.0.0.1",             // 监听地址（仅本机可用）
      "listen_port": 7890                // 监听端口
    }
  ],

  // 路由分流与匹配规则
  "route": {
    "default_http_client": "rule-set-direct", // 默认 HTTP 客户端（用于规则集下载）
    "default_domain_resolver": "dns-cn",      // 默认域名解析器（用于路由模块本身的域名解析）
    "auto_detect_interface": true,            // 自动检测默认出口网卡（防止流量环路）

    // 远程规则集（Rule Sets）定义
    "rule_set": [
      {
        "tag": "geosite-cn",             // 规则集标签：国内域名集合
        "type": "remote",                // 规则集类型：远程下载
        "format": "binary",              // 文件格式：编译后的二进制 SRS 格式
        "url": "https://cdn.jsdelivr.net/gh/EasySBTeam/Proxy-Rules-Data@sing/geo/geosite/cn.srs" // 远程规则文件下载 URL
      },
      {
        "tag": "geoip-cn",               // 规则集标签：国内 IP 集合
        "type": "remote",                // 规则集类型：远程下载
        "format": "binary",              // 文件格式：二进制 SRS 格式
        "url": "https://cdn.jsdelivr.net/gh/EasySBTeam/Proxy-Rules-Data@sing/geo/geoip/cn.srs" // 远程规则文件下载 URL
      }
    ],

    // 路由分流规则链（按顺序自上而下匹配，首次匹配即止）
    "rules": [
      // 1. 劫持发往 TUN 网卡的所有 DNS 流量，强制送入内置 DNS 模块处理
      {
        "inbound": ["tun-in"],          // 匹配入站：来自 TUN 网卡
        "protocol": ["dns"],            // 匹配协议：DNS 协议流量
        "action": "hijack-dns"          // 执行动作：DNS 劫持
      },
      // 2. 当控制面板模式被切为 Global（全局）时：所有流量路由至代理策略组
      {
        "clash_mode": "Global",          // 匹配 Clash 模式：全局模式
        "action": "route",              // 执行动作：指定出站路由
        "outbound": "proxy"             // 路由出站到 proxy 策略组
      },
      // 3. 内网私有 IP 地址：直连出站
      {
        "ip_is_private": true,          // 匹配条件：目标 IP 为局域网/私有 IP
        "action": "route",              // 执行动作：指定出站路由
        "outbound": "direct"            // 路由出站到直连
      },
      // 4. 国内域名集合（geosite-cn）：直连出站
      {
        "rule_set": ["geosite-cn"],     // 匹配条件：符合 geosite-cn 规则集
        "action": "route",              // 执行动作：指定出站路由
        "outbound": "direct"            // 路由出站到直连
      },
      // 5. 国内 IP 地址集合（geoip-cn）：直连出站
      {
        "rule_set": ["geoip-cn"],       // 匹配条件：符合 geoip-cn 规则集
        "action": "route",              // 执行动作：指定出站路由
        "outbound": "direct"            // 路由出站到直连
      },
      // 6. 当控制面板模式被切为 Direct（直连）时：所有流量路由至直连出站
      {
        "clash_mode": "Direct",          // 匹配 Clash 模式：直连模式
        "action": "route",              // 执行动作：指定出站路由
        "outbound": "direct"            // 路由出站到直连
      },
      // 7. 阻断 DoT（DNS over TLS，端口 853）流量，防止应用程序硬编码绕过本地 DNS
      {
        "network": ["tcp", "udp"],      // 匹配网络传输层：TCP 及 UDP
        "port": 853,                    // 匹配目标端口：853
        "action": "reject"              // 执行动作：拒绝连接
      }
    ],

    "final": "proxy"                     // 兜底路由：未匹配到上述任何规则时，默认走 proxy 策略组
  },

  // 实验性功能与第三方兼容 API 配置
  "experimental": {
    // DNS 缓存持久化保存文件配置
    "cache_file": {
      "enabled": true,                   // 开启缓存文件功能
      "store_dns": true                  // 将 DNS 缓存持久化写入磁盘，重启后无需重新解析
    },
  // Clash API 兼容控制接口（便于搭配 Yacd / Metacubexd / Zashboard 等 Web UI 管理界面）
    "clash_api": {
      "external_controller": "127.0.0.1:9090", // REST UI 控制器的监听地址与端口（0.0.0.0 表示允许局域网及外部 IP 访问，9090 为默认端口）
      "external_ui": "ui",                     // Web UI 静态资源文件在本地的相对/绝对路径（解压后文件存储在该目录下）
      "external_ui_download_url": "https://gh-proxy.com/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages.zip", // Web UI 面板压缩包下载地址（本地缺少 UI 文件时自动下载）
      "external_ui_download_detour": "direct", // 下载 Web UI 界面时使用的出站标签（已由原来的"直连"修正为 outbounds 中对应的 "direct"）
      "secret": "",                          // 由面板按账号派生，勿在此写死（见 generate.go 的 clashSecret）
      "default_mode": "Rule"                 // 服务启动时的默认分流模式（可选: Rule-规则模式, Global-全局代理, Direct-全局直连）
    }
  },

  // 出站节点与节点策略组配置
  "outbounds": [
    // -------------------------------------------------------------------
    // 节点 1：AnyTLS 协议节点
    // -------------------------------------------------------------------
    {
      "type": "anytls",                  // 节点类型：AnyTLS
      "tag": "anytls",                    // 节点标签名称
      "server": "example.com",           // 服务器地址（IP 或域名）
      "server_port": 8000,               // 服务器端口
      "password": "8JCsPssfgS8tiRwiMlhARg==", // 身份验证密码
      "idle_session_check_interval": "30s",  // 空闲连接检查的时间间隔
      "idle_session_timeout": "30s",         // 空闲连接超时回收时长
      "min_idle_session": 5,                 // 连接池保持的最少空闲连接数
      "tls": {                           // TLS 加密传输层配置
        "enabled": true,                 // 启用 TLS 加密
        "server_name": "example.com",    // TLS 握手 SNI 域名
        "alpn": [                        // 应用层协商协议列表
          "h3",                          // HTTP/3
          "h2",                          // HTTP/2
          "http/1.1"                     // HTTP/1.1
        ],
        "utls": {                        // uTLS 客户端指纹伪装
          "enabled": true,               // 开启 uTLS 指纹伪装
          "fingerprint": "chrome"        // 伪装目标：Chrome 浏览器 TLS 握手特征
        }
      }
    },

    // -------------------------------------------------------------------
    // 节点 2：Hysteria 2 协议节点 (UDP/QUIC 高速传输)
    // -------------------------------------------------------------------
    {
      "type": "hysteria2",               // 节点类型：Hysteria 2
      "tag": "hysteria2",                // 节点标签名称
      "server": "example.com",           // 服务器地址（IP 或域名）
      "server_ports":["2080:3000"],     // 允许在 2080 到 3000 端口范围内动态切换
      "hop_interval": "30s",             // 自动跳跃/切换端口的时间间隔
      "up_mbps": 20,                      // 客户端预测的最大上行带宽（Mbps），用于拥塞控制
      "down_mbps": 100,                  // 客户端预测的最大下行带宽（Mbps），用于拥塞控制
      "password": "8JCsPssfgS8tiRwiMlhARg==", // 用户验证密码
      "tls": {                           // TLS 配置
        "enabled": true,                 // 开启 TLS 加密
        "server_name": "example.com",    // TLS 握手 SNI 域名
        "alpn": [                        // ALPN 协议协商
          "h3"                           // Hysteria 2 必须使用 h3 (HTTP/3)
        ]
      }
    },

    // -------------------------------------------------------------------
    // 节点 3：TUIC 协议节点 (基于 QUIC/UDP 的低延迟高性能传输)
    // -------------------------------------------------------------------
    {
      "type": "tuic",                    // 节点类型：TUIC（客户端）
      "tag": "tuic",                     // 该节点的标识标签（用于策略组和路由绑定）
      "server": "example.com",           // 远程 TUIC 服务器地址（IP 或域名）
      "server_port": 8001,               // 远程服务器监听端口
      "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户身份验证 UUID（需与服务端一致）
      "password": "hello",              // 用户认证密码（需与服务端一致）
      "congestion_control": "bbr",      // QUIC 拥塞控制算法（建议 bbr，可大幅优化高丢包高延迟网络）
      "udp_relay_mode": "native",       // UDP 转发模式（native: 原生 UDP 数据包转发，适合游戏与实时音视频）
      "udp_over_stream": false,         // 是否开启 UDP Over Stream（false 表示原生的 QUIC 数据包传输）
      "zero_rtt_handshake": false,      // 是否开启 0-RTT 快速握手（false 可防重放攻击，true 降低握手延迟）
      "heartbeat": "10s",               // 保活心跳包间隔（维持长连接并检测链路连通性）
      "network": "tcp",                 // 标示请求传输承载类型
      // TLS 传输层安全配置
      "tls": {
        "enabled": true,                // 开启 TLS 加密传输
        "server_name": "us.kejizero.xyz",   // TLS 握手 SNI 验证域名（需匹配服务端证书）
        "alpn": [                       // 应用层协议协商
          "h3"                          // TUIC 基于 QUIC，必须配置为 h3
        ]
      }
    },

    // -------------------------------------------------------------------
    // 节点 4：VMess + WebSocket + TLS + Mux 多路复用节点
    // -------------------------------------------------------------------
    {
      "type": "vmess",                   // 节点类型：VMess
      "tag": "vmess-ws-tls",             // 节点标签名称
      "server": "example.com",           // 服务器地址（IP 或域名）
      "server_port": 8002,               // 服务器端口
      "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户 UUID 密钥
      "security": "auto",                // 加密算法，默认自动协商（auto）
      "alter_id": 0,                     // 额外 ID，现代 VMess 规范固定设置为 0
      "global_padding": false,           // 是否启用全局数据包填充
      "authenticated_length": true,      // 开启数据包长度校验头（防主动探测）
      "tls": {                           // TLS 安全配置
        "enabled": true,                 // 开启 TLS
        "server_name": "example.com",    // SNI 目标域名
        "utls": {                        // uTLS 客户端指纹伪装
          "enabled": true,               // 开启指纹伪装
          "fingerprint": "chrome"        // 伪装为 Chrome 浏览器
        }
      },
      "packet_encoding": "packetaddr",   // UDP 数据包编码传输格式（支持 UDP over TCP）
      "multiplex": {                     // Mux 单连接多路复用配置
        "enabled": true,                 // 开启多路复用
        "protocol": "smux",              // 复用协议类型：smux
        "max_connections": 4,            // 最大建立的并发连接数
        "min_streams": 4,                // 触发新建连接的最小并发流数
        "max_streams": 0,                // 每个连接允许的最大并发流数（0 表示无限制）
        "padding": false                 // 复用层数据包填充
      },
      "transport": {                     // 传输层配置
        "type": "ws",                    // 传输协议：WebSocket
        "path": "/vmess",                // WebSocket 协议连接路径
        "max_early_data": 2048,          // WebSocket 允许的最大 Early Data 长度
        "early_data_header_name": "Sec-WebSocket-Protocol" // Early Data 请求头名称
      }
    },

    // -------------------------------------------------------------------
    // 节点 5：VLESS + Vision + REALITY 节点 (抗封锁与免证书伪装)
    // -------------------------------------------------------------------
    {
      "type": "vless",                   // 节点类型：VLESS
      "tag": "vless-vision-reality",    // 节点标签名称
      "server": "example.com",          // 远程 VPS 的真实 IP 地址或域名
      "server_port": 8003,              // 服务器监听端口（REALITY 必须为 443）
      "uuid": "a9a6e2b5-5e34-4899-9865-f021e27bafc3", // 用户唯一身份验证 UUID
      "flow": "xtls-rprx-vision",        // 流控算法：Vision，消解双重 TLS 与数据包特征
      "tls": {                           // TLS / REALITY 安全配置
        "enabled": true,                 // 启用 TLS
        "server_name": "apple.com",     // REALITY 借用的伪装服务器 SNI 域名
        "utls": {                        // uTLS 客户端指纹伪装
          "enabled": true,               // 开启指纹伪装
          "fingerprint": "chrome"        // 必须匹配真实的浏览器指纹（Chrome）
        },
        "reality": {                     // REALITY 协议配置
          "enabled": true,               // 启用 REALITY 无证书伪装协议
          "public_key": "jgcVPebui9A55ultlIF0VuESK8eMi9A0v24-wrYBpzU", // REALITY 服务端公钥 (Public Key)
          "short_id": "5b6966df"        // REALITY 服务端 Short ID 匹配标识
        }
      },
      "packet_encoding": "xudp"          // UDP 数据包编码规范：xudp（具备极高的并发与游戏传输性能）
    },

    // -------------------------------------------------------------------
    // 策略组 1：手动选择节点组 (Selector)
    // -------------------------------------------------------------------
    {
      "tag": "proxy",                    // 策略组标签（对应分流规则中的 outbound: "proxy"）
      "type": "selector",                // 策略组类型：手动选择
      "default": "auto",                 // 默认选中的子项标签（默认选择自动测速组）
      "outbounds": [                     // 包含的可供选择节点及策略组列表
        "auto",                          // 关联选项：自动测速策略组
        "anytls",                        // 关联节点 1
        "hysteria2",                     // 关联节点 2
        "tuic",                          // 关联节点 3
        "vmess-ws-tls",                  // 关联节点 4
        "vless-vision-reality"           // 关联节点 5
      ]
    },

    // -------------------------------------------------------------------
    // 策略组 2：自动延时测速选优组 (URLTest)
    // -------------------------------------------------------------------
    {
      "tag": "auto",                     // 策略组标签
      "type": "urltest",                 // 策略组类型：自动测速选优
      "outbounds": [                     // 参与自动延迟测试的节点列表
        "anytls",
        "hysteria2",
        "tuic",
        "vmess-ws-tls",
        "vless-vision-reality"
      ],
      "url": "http://www.gstatic.com/generate_204", // 用于测试节点连通性与延迟的 204 测试 URL
      "interval": "10m",                 // 自动定期触发延迟测试的时间间隔（每 10 分钟）
      "tolerance": 30,                    // 切换节点的延迟容忍差值（毫秒）；只有新节点比当前节点快 30ms 以上时才切换，避免频繁切换
      "idle_timeout": "30m"              // 超过 30 分钟无流量使用时停止后台定时测速以省电/省流量
    },

    // -------------------------------------------------------------------
    // 出站 3：直连出站 (Direct)
    // -------------------------------------------------------------------
    {
      "type": "direct",                  // 出站类型：直连（不经过任何代理，直接请求目标服务）
      "tag": "direct"                    // 节点标签（对应分流规则中的 outbound: "direct"）
    }
  ]
}
